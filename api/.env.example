# Set to "true" only in local development — shows real exception messages in
# API error responses. Leave unset/false in production (errors are still
# logged server-side via error_log either way).
APP_DEBUG=false

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Note: the Google Gemini key used for chat responses (API_GOOGLE_GEMINI) is
# NOT read from this file — it's managed separately in api/admin/.env via the
# admin panel's "API Ayarları" page (admin/api.php), read server-side only by
# ChatController::generateReply. Never sent to the client.

# Email
CONTACT_EMAIL=admin@example.com
NOREPLY_EMAIL=no-reply@example.com

# Param POS (ödeme sistemi)
PARAM_RECONCILE_SECRET=your-secret-key

# Veritabanı — DÖRDÜ DE ZORUNLU. Eksikse uygulama bağlanmak yerine hata verir
# (SEC-008: eskiden db.php içinde hard-coded dev değerlerine düşüyordu).
# Parolasız bir kullanıcı için DB_PASS= satırını boş bırakın.
DB_HOST=localhost:3306
DB_NAME=lumanoris
DB_USER=root
DB_PASS=

# Veritabanı yedeklerinin yazılacağı dizin. Varsayılan: repo kökündeki
# storage/db_backup (doküman kökünün DIŞINDA — bkz. SEC-001).
# DB_BACKUP_DIR=/var/backups/lumanoris

# Param POS kimlik bilgileri (SEC-018: eskiden web/.env içindeydi; onları
# kullanacak olan PHP tarafı, o yüzden buraya taşındı).
PARAM_CLIENT_CODE=
PARAM_CLIENT_USERNAME=
PARAM_CLIENT_PASSWORD=
PARAM_GUID=
PARAM_MARKETPLACE_GUID=
PARAM_PAYMENT_WSDL=
PARAM_MARKETPLACE_WSDL=
PARAM_PAYMENT_SECURITY_TYPE=
PARAM_REF_URL=
PARAM_SUCCESS_URL=
PARAM_FAIL_URL=

# PAY-007: parampos_callback.php bu sır olmadan HİÇBİR bildirimi kabul etmez
# (fail-closed). Gateway tarafında da aynı değer tanımlanmalı.
PARAM_CALLBACK_SECRET=

# SMTP (DEP-003). Boş bırakılırsa admin panelindeki "SMTP Ayarları"
# sayfasından yönetilen global_vars satırları kullanılır.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_NAME=Lumanoris
# SMTP_ENCRYPTION=auto

# PHP hata logunun yazılacağı dosya. Varsayılan: repo kökündeki
# storage/logs/php-error.log (doküman kökünün DIŞINDA — SEC-001).
# APP_LOG_FILE=/var/log/lumanoris/php-error.log

# mysqldump / mysql ikililerinin dizini. PATH üzerinde değillerse zorunlu
# (Windows kurulumları ve çoğu paylaşımlı hosting bunları PATH'e eklemez).
# MYSQL_BIN_DIR=C:/Program Files/MySQL/MySQL Server 8.0/bin
